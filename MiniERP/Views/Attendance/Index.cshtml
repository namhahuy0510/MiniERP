@model IEnumerable<MiniERP.Models.Attendance>

@{
    ViewData["Title"] = "Chấm công (Admin)";
    var selectedDate = (DateTime)(ViewBag.Date ?? DateTime.Today);
    var employees = ViewBag.Employees as List<MiniERP.Models.Employee> ?? new List<MiniERP.Models.Employee>();
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">
            <i class="bi bi-calendar-check me-2 text-primary"></i>Chấm công ngày @selectedDate.ToString("dd/MM/yyyy")
        </h2>
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="date" name="date" class="form-control form-control-sm"
                   value="@selectedDate.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-search me-1"></i>Xem
            </button>
        </form>
    </div>

    <div class="card mb-3 shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title mb-3">Thêm bản ghi chấm công</h5>
            <form asp-action="Tick" method="post" class="row g-2 align-items-end">
                <input type="hidden" name="employeeId" id="attendanceEmployeeId" required />

                <div class="col-md-6">
                    <label class="form-label">Nhân viên</label>
                    <div class="input-group input-group-sm">
                        <input type="text"
                               id="attendanceEmployeeDisplay"
                               class="form-control"
                               placeholder="Chưa chọn nhân viên"
                               readonly />
                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="searchEmployeeForAttendance()">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <small class="text-muted">Dùng ô tìm kiếm để chọn nhanh nhân viên.</small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Có mặt?</label>
                    <select name="isPresent" class="form-select form-select-sm">
                        <option value="true">Có mặt</option>
                        <option value="false">Vắng</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex justify-content-end">
                    <button type="submit" class="btn btn-sm btn-primary mt-3 mt-md-0">
                        <i class="bi bi-plus-circle me-1"></i>Lưu chấm công
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title mb-3">Danh sách chấm công ngày @selectedDate.ToString("dd/MM/yyyy")</h5>
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">Chưa có bản ghi chấm công nào cho ngày này.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Nhân viên</th>
                                <th>Vị trí</th>
                                <th>Có mặt</th>
                                <th>Check-in</th>
                                <th>Check-out</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var stt = 1;
                            }
                            @foreach (var a in Model)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td>@a.Employee?.FullName</td>
                                    <td>@a.Employee?.Position</td>
                                    <td>
                                        @if (a.IsPresent)
                                        {
                                            <span class="badge bg-success">Có mặt</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Vắng</span>
                                        }
                                    </td>
                                    <td>@a.CheckInTime?.ToString("HH:mm")</td>
                                    <td>@a.CheckOutTime?.ToString("HH:mm")</td>
                                    <td class="text-end">
                                        @if (a.IsPresent && a.CheckOutTime == null)
                                        {
                                            <form asp-action="Checkout" method="post" class="d-inline">
                                                <input type="hidden" name="attendanceId" value="@a.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-box-arrow-right me-1"></i>Checkout
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("_SearchModal")
