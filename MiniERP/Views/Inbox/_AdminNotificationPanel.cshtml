@model MiniERP.Models.AdminNotification

<div class="card mb-4 shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-megaphone-fill text-danger"></i>
            <span class="fw-semibold">Quản trị thông báo chung</span>
        </div>
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
            Chỉ Admin
        </span>
    </div>
    <div class="card-body">
        <form asp-controller="Inbox" asp-action="CreateNotification" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-12 col-md-6">
                <label asp-for="Title" class="form-label">Tiêu đề</label>
                <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề thông báo" />
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="Type" class="form-label">Loại</label>
                <select asp-for="Type" class="form-select">
                    <option value="info">Thông tin</option>
                    <option value="success">Thành công</option>
                    <option value="warning">Cảnh báo</option>
                    <option value="danger">Khẩn cấp</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="From" class="form-label">Người gửi</label>
                <input asp-for="From" class="form-control" value="@User.Identity?.Name" />
            </div>
            <div class="col-12">
                <label asp-for="Message" class="form-label">Nội dung</label>
                <textarea asp-for="Message" class="form-control" rows="3" placeholder="Nhập nội dung thông báo gửi tới toàn hệ thống"></textarea>
            </div>
            <div class="col-12 d-flex justify-content-end">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-send-exclamation-fill me-1"></i> Gửi thông báo chung
                </button>
            </div>
        </form>
    </div>
</div>

