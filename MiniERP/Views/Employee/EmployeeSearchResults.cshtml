@model IEnumerable<MiniERP.Models.Employee>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Id</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Vị trí</th>
            <th>Lương</th>
            <th>Ngày vào</th>
            <th>Ngày kết thúc</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr class="employee-select-row"
                data-id="@emp.Id"
                data-name="@emp.FullName"
                data-position="@emp.Position">
                <td>@emp.Id</td>
                <td>@emp.FullName</td>
                <td>@emp.DateOfBirth.ToShortDateString()</td>
                <td>@emp.Position</td>
                <td>@emp.Salary</td>
                <td>@emp.StartDate.ToShortDateString()</td>
                <td>@emp.EndDate?.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>
