@model IEnumerable<MiniERP.Models.Employee>

@{
    ViewData["Title"] = "Trang quản lý nhân viên";
    int stt = 1;
}

<div class="text-center mb-4">
    <h1 class="display-4">Trang quản lý nhân viên</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm nhân viên mới</a>
</div>

<div class="mb-3 d-flex justify-content-start">
    <input type="text" id="searchBox" placeholder="Nhập tên nhân viên..."
           class="form-control flex-grow-1 me-2" style="max-width:400px;" />
    <button type="button" class="btn btn-primary" onclick="searchEmployee()">Tìm kiếm</button>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>STT</th>
            <th>Id</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Vị trí</th>
            <th>Lương</th>
            <th>Ngày vào</th>
            <th>Ngày kết thúc</th>
            <th style="width:150px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@stt</td>
                <td>@emp.Id</td>
                <td>@emp.FullName</td>
                <td>@emp.DateOfBirth.ToShortDateString()</td>
                <td>@emp.Position</td>
                <td>@emp.Salary</td>
                <td>@emp.StartDate.ToShortDateString()</td>
                <td>@emp.EndDate?.ToShortDateString()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-warning me-1">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
            stt++;
        }
    </tbody>
</table>

@await Html.PartialAsync("_SearchModal")
