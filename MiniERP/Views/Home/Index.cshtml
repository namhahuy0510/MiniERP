@{
    ViewData["Title"] = T.GetString("Home");
}

<div class="container py-4">
    @* Header & Real-time Clock *@
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h1 class="display-4 fw-bold text-primary">@T.GetString("WelcomeMessage")</h1>
            <p class="lead text-secondary">
                @T.GetString("AccessNow") 
                <a href="https://github.com/namhahuy0510/MiniERP/tree/master" target="_blank" class="text-decoration-none">
                    <i class="bi bi-github"></i> @T.GetString("SolutionDescription")
                </a>
            </p>
        </div>
        <div class="col-md-4 text-md-end text-center">
            <div class="card shadow-sm border-0 bg-light p-3 border-start border-primary border-4">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clock-fill text-warning me-2"></i><span id="digital-clock">--:--:--</span></h5>
                <small class="text-muted" id="current-date">Ngày tháng năm</small>
            </div>
        </div>
    </div>

    <div class="row">
        @* Carousel (Bên trái) *@
        <div class="col-lg-8 mb-4">
            <div id="miniErpCarousel" class="carousel slide shadow-lg rounded-4 overflow-hidden" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#miniErpCarousel" data-bs-slide-to="0" class="active"></button>
                    <button type="button" data-bs-target="#miniErpCarousel" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#miniErpCarousel" data-bs-slide-to="2"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active" data-bs-interval="3000">
                        <img src="https://github.com/user-attachments/assets/e372542f-cdfd-44d7-bd4e-fec386d8dfd3"
                             class="d-block w-100" style="height:450px; object-fit:cover;" alt="Home">
                        
                    </div>
                    <div class="carousel-item" data-bs-interval="3000">
                        <img src="https://github.com/user-attachments/assets/d83aadca-0106-418c-aa54-376f3b9c6271"
                             class="d-block w-100" style="height:450px; object-fit:cover;" alt="Employee">
                    </div>
                    <div class="carousel-item" data-bs-interval="3000">
                        <img src="https://github.com/user-attachments/assets/94d49219-df81-484c-af33-f13d356f06e0"
                             class="d-block w-100" style="height:450px; object-fit:cover;" alt="Update">
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#miniErpCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#miniErpCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>

            <div class="text-center mt-5">
                <a asp-controller="Employee" asp-action="EmployeeManagement" class="btn btn-primary btn-lg shadow px-5 rounded-pill transform-hover">
                    <i class="bi bi-rocket-takeoff-fill me-2"></i> @T.GetString("GoToEmployeeManagement")
                </a>
            </div>
        </div>

        @* News Feed (Bên phải - KHÔNG DÙNG IFRAME ĐỂ TRÁNH LỖI) *@
        <div class="col-lg-4 mb-4">
            <div class="card shadow border-0 h-100 rounded-4">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-danger"><i class="bi bi-lightning-fill me-1"></i>Tin vắn 24h</h5>
                    <span class="badge bg-danger rounded-pill">LIVE</span>
                </div>
                <div class="card-body p-3 overflow-auto" style="max-height: 500px;" id="news-feed">
                    <div class="text-center py-5" id="news-loader">
                        <div class="spinner-border text-danger" role="status"></div>
                        <p class="mt-2 text-muted small">Đang tải tin tức mới nhất...</p>
                    </div>
                    @* Tin tức sẽ được render vào đây bằng JS *@
                </div>
                <div class="card-footer bg-light border-0 text-center py-2">
                    <small class="text-muted">Nguồn: VnExpress.net</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transform-hover { transition: transform 0.3s; }
    .transform-hover:hover { transform: scale(1.05); }
    .news-item { border-bottom: 1px solid #f0f0f0; transition: background 0.2s; cursor: pointer; }
    .news-item:hover { background: #fdfdfd; }
    .news-item:last-child { border-bottom: none; }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Đồng hồ thời gian thực
            function updateClock() {
                const now = new Date();
                document.getElementById('digital-clock').textContent = now.toLocaleTimeString();
                document.getElementById('current-date').textContent = now.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            }
            setInterval(updateClock, 1000);
            updateClock();

            // 2. Lấy tin tức bằng JavaScript RSS (Dùng RSS2JSON để bypass CORS)
            const newsFeed = document.getElementById('news-feed');
            const loader = document.getElementById('news-loader');
            const rssUrl = 'https://vnexpress.net/rss/tin-moi-nhat.rss';
            const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(rssUrl)}`;

            fetch(apiUrl)
                .then(res => res.json())
                .then(data => {
                    loader.remove();
                    if(data.status === 'ok') {
                        data.items.slice(0, 6).forEach(item => {
                            const html = `
                                <div class="news-item py-3" onclick="window.open('${item.link}', '_blank')">
                                    <h6 class="mb-1 fw-bold small text-dark">${item.title}</h6>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted" style="font-size: 0.7rem;">${new Date(item.pubDate).toLocaleTimeString('vi-VN')}</span>
                                        <i class="bi bi-chevron-right text-muted small"></i>
                                    </div>
                                </div>
                            `;
                            newsFeed.insertAdjacentHTML('beforeend', html);
                        });
                    } else {
                        newsFeed.innerHTML = '<p class="text-muted text-center py-5">Không thể tải tin tức lúc này.</p>';
                    }
                })
                .catch(err => {
                    loader.remove();
                    newsFeed.innerHTML = '<p class="text-muted text-center py-5">Lỗi kết nối nguồn tin.</p>';
                });
        });
    </script>
}